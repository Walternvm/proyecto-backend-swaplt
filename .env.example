# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swaplt-db
DB_USER=postgres
DB_PASSWORD=postgres

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SQL_INIT_MODE=never

# JWT
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@swaplt.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Optional initial administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=